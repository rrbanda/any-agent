# Agent configuration - JSON map of agent ID to config
# Supported protocol values: "ag-ui", "langgraph", "openai", "google-adk"
AGENTS='{"demo":{"url":"http://localhost:8000","name":"Demo Agent","description":"A demo AG-UI agent","protocol":"ag-ui"}}'

# Multi-protocol example (uncomment and adjust URLs):
# AGENTS='{"demo":{"url":"http://localhost:8000","name":"Demo AG-UI","description":"AG-UI echo agent","protocol":"ag-ui"},"langgraph":{"url":"http://localhost:8001/runs/stream","name":"LangGraph Agent","description":"LangGraph-based agent","protocol":"langgraph"},"hermes":{"url":"http://localhost:8002/api/chat","name":"Hermes (vLLM)","description":"OpenAI-compatible endpoint","protocol":"openai"},"adk":{"url":"http://localhost:8003","name":"ADK Agent","description":"Google ADK agent","protocol":"google-adk"}}'

# Default agent to select on load
DEFAULT_AGENT=demo

# Branding
APP_TITLE=Any Agent
APP_LOGO_URL=

# Auth (future)
# OIDC_ISSUER_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=

# Database for thread persistence (optional — app works without it)
# DATABASE_URL=postgresql://user:pass@localhost:5432/anyagent

# File upload storage (optional — defaults to local ./uploads)
# UPLOAD_DIR=./uploads
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
