# ---------------------------------------------------------------------------
# Any Agent — Environment Configuration
# ---------------------------------------------------------------------------

# Agent configuration — JSON map of agent ID to config.
# Protocol is optional; if omitted, Any Agent auto-detects it by probing the URL.
# Supported protocols: "ag-ui", "langgraph", "openai", "google-adk"
AGENTS='{"demo":{"url":"http://localhost:8000","name":"Demo Agent","description":"A demo AG-UI agent"}}'

# Multi-protocol example (uncomment and adjust URLs):
# AGENTS='{"demo":{"url":"http://localhost:8000","name":"Demo AG-UI","description":"AG-UI echo agent","protocol":"ag-ui"},"hermes":{"url":"http://localhost:8002/v1/chat/completions","name":"Hermes","description":"OpenAI-compatible","protocol":"openai"},"adk":{"url":"http://localhost:8003","name":"ADK Agent","description":"Google ADK agent"}}'

# Default agent to select on load
DEFAULT_AGENT=demo

# Branding
APP_TITLE=Any Agent
APP_LOGO_URL=

# Optional: agentregistry URL for agent discovery.
# When set, agents from the registry are merged with AGENTS above.
# AGENT_REGISTRY_URL=http://localhost:12121

# Auth (future)
# OIDC_ISSUER_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
