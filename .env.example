# Agent configuration - JSON map of agent key to config
AGENTS='{"demo":{"url":"http://localhost:8000","name":"Demo Agent","description":"A demo AG-UI agent"}}'

# Default agent to select on load (must match a key in AGENTS)
DEFAULT_AGENT=demo

# Branding
APP_TITLE=Any Agent
APP_LOGO_URL=
APP_PRIMARY_COLOR=#6963ff

